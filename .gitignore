# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# KYNZA custom
.env
*.env
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
*.g.dart
*.freezed.dart
docs/testing/TEST_ACCOUNTS.md
android/.kotlin/
.claude/settings.local.json

# Release signing — never commit the real upload keystore or its
# passwords (Phase 10, Enterprise Hardening pass). key.properties.template
# (no real secrets) is intentionally NOT ignored.
android/key.properties
*.jks
*.keystore

# Production data backups (Phase 0, remediation-v1) — contain real customer
# PII, must never enter git history. Only docs/remediation/ manifests
# (row counts, no data values) are tracked.
/backups/
